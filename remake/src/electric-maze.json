      "text": "SIGH...",
      "portrait": "spr_face_papyrusside",
      "font": "fnt_papyrus"
    },
    {
      "text": "WHY COULDN'T WE GET\nA HUMAN THAT LIKES\nPUZZLES???",
      "portrait": "spr_face_papyrusside",
      "font": "fnt_papyrus"
    }
