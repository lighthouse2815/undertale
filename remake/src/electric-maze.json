  "murderSecond": [
    {
      "text": "UHHHHHHH...?",
      "portrait": "spr_face_papyrussweat",
      "font": "fnt_papyrus"
    },
    {
      "text": "HMMM... YOU MUST\nBE HAVING\nCULTURE SHOCK.",
      "portrait": "spr_face_papyrusside",
      "font": "fnt_papyrus"
    },
    {
      "text": "YOU SEE, WHERE I\nCOME FROM, IT'S\nA LOVING TRADITION.",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    },
    {
      "text": "TO SUFFER THROUGH\nHORRIBLE PUZZLES\nFOR NO REASON.",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    },
    {
      "text": "SO, UH, JUST\nWALK BACK THERE,\nAND...",
      "portrait": "spr_face_papyrussweat",
      "font": "fnt_papyrus"
