  "chill": [
    {
      "text": "* Guh huh huh huh.",
      "portrait": null,
      "font": "fnt_maintext"
    },
    {
      "text": "* Us teens rule these woods\n  with a smaller-than-\n  adult fist.",
      "portrait": null,
