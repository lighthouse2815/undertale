{
  "intro": [
    {
      "text": "SO, AS I\nWAS SAYING\nABOUT UNDYNE,",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    }
  ],
  "introMurder": [
    {
      "text": "SO SANS!\nWHEN'S THE HUMAN\nSHOWING UP???",
      "portrait": "spr_face_papyruslaugh",
      "font": "fnt_papyrus"
    },
    {
      "text": "I WANT TO LOOK\nMY SUNDAY BEST...",
      "portrait": "spr_face_papyrusside",
      "font": "fnt_papyrus"
    },
    {
      "text": "OR AT LEAST MY\nTUESDAY\nPRETTY-GOOD.",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    },
    {
      "text": "* don't you only have\n  one outfit?",
      "portrait": "spr_face_sanschuckle",
      "font": "fnt_comicsans"
    },
    {
      "text": "YEAH, BUT I COULD\nSTYLE MY HAIR!",
      "portrait": "spr_face_papyruslaugh",
      "font": "fnt_papyrus"
    },
    {
      "text": "* oh. right.\n* good idea.",
      "portrait": "spr_face_sans",
      "font": "fnt_comicsans"
    },
    {
      "text": "* say, why don't you\n  look over there?",
      "portrait": "spr_face_sanschuckle",
      "font": "fnt_comicsans"
    }
  ],
  "notice": [
    {
      "text": "SANS!!\nOH MY GOD!!\nIS THAT...",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    },
    {
      "text": "A HUMAN!?!?\n!??!?!",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    }
  ],
  "noticeAgain": [
    {
      "text": "SANS!!\nOH MY GOD!!\nIS THAT...",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    },
    {
      "text": "A HUMAN!?!?\n!??!?!",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    },
    {
      "text": "AND IT LOOKS SO\nFAMILIAR...!!!",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    }
  ],
  "noticeMurder": [
    {
      "text": "SANS!!!\nOH MY GOD!!!!",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    },
    {
      "text": "I'M DIZZY.\nWHAT AM I LOOKING\nAT?",
      "portrait": "spr_face_papyrusside",
      "font": "fnt_papyrus"
    },
    {
      "text": "* behold.",
      "portrait": "spr_face_sanschuckle",
      "font": "fnt_comicsans"
    }
  ],
  "rock": [
    {
      "text": "* uhhhh...",
      "portrait": "spr_face_sans",
      "font": "fnt_comicsans"
    },
    {
      "text": "* actually, i think that's\n  a rock.",
      "portrait": "spr_face_sanschuckle",
      "font": "fnt_comicsans"
    }
  ],
  "rockAgain": [
    {
      "text": "* uhhhh...\n* i think it looks\n  familiar...",
      "portrait": "spr_face_sans",
      "font": "fnt_comicsans"
    },
    {
      "text": "* because it's a rock?",
      "portrait": "spr_face_sanschuckle",
      "font": "fnt_comicsans"
    }
  ],
  "rockMurder": [
    {
      "text": "OH MY GOD!!!",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    }
  ],
  "oh": [
    {
      "text": "OH.",
      "portrait": "spr_face_papyrusside",
      "font": "fnt_papyrus"
    }
  ],
  "ohMurder": [
    {
      "text": "WHY ARE YOU\nTELLING ME TO\nLOOK AT A ROCK.",
      "portrait": "spr_face_papyrusside",
      "font": "fnt_papyrus"
    }
  ],
  "front": [
    {
      "text": "* hey, what's that in\n  front of the rock?",
      "portrait": "spr_face_sans",
      "font": "fnt_comicsans"
    }
  ],
  "surprise": [
    {
      "text": "OH MY GOD!!!",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    }
  ],
  "human": [
    {
      "text": "(IS... IS THAT\nA HUMAN)",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    }
  ],
  "humanMurder": [
    {
      "text": "I HAVE NO IDEA\nWHAT THAT IS.",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    }
  ],
  "yes": [
    {
      "text": "(yes)",
      "portrait": "spr_face_sans",
      "font": "fnt_comicsans"
    }
  ],
  "yesMurder": [
    {
      "text": "* well.\n* it's not a rock.",
      "portrait": "spr_face_sans",
      "font": "fnt_comicsans"
    }
  ],
  "plan": [
    {
      "text": "OH MY GOD!!!",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    },
    {
      "text": "SANS!\nI FINALLY\nDID IT!!",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    },
    {
      "text": "UNDYNE WILL...",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    },
    {
      "text": "I'M GONNA...",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    },
    {
      "text": "I'LL BE SO...",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    },
    {
      "text": "POPULAR!!!\nPOPULAR!!!\nPOPULAR!!!",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    },
    {
      "text": "...'AHEM'",
      "portrait": "spr_face_papyrusside",
      "font": "fnt_papyrus"
    },
    {
      "text": "HUMAN! YOU\nSHALL NOT PASS\nTHIS AREA!",
      "portrait": "spr_face_papyrusmad",
      "font": "fnt_papyrus"
    },
    {
      "text": "I, THE GREAT\nPAPYRUS, WILL\nSTOP YOU!!!",
      "portrait": "spr_face_papyrusmad",
      "font": "fnt_papyrus"
    },
    {
      "text": "I WILL THEN\nCAPTURE YOU!",
      "portrait": "spr_face_papyrusmad",
      "font": "fnt_papyrus"
    },
    {
      "text": "YOU WILL BE\nDELIVERED TO\nTHE CAPITAL!",
      "portrait": "spr_face_papyrusmad",
      "font": "fnt_papyrus"
    },
    {
      "text": "THEN...\nTHEN!!!",
      "portrait": "spr_face_papyrusmad",
      "font": "fnt_papyrus"
    },
    {
      "text": "I'M NOT SURE\nWHAT'S NEXT.",
      "portrait": "spr_face_papyrusside",
      "font": "fnt_papyrus"
    },
    {
      "text": "IN ANY CASE!",
      "portrait": "spr_face_papyrusmad",
      "font": "fnt_papyrus"
    },
    {
      "text": "CONTINUE...\nONLY IF YOU\nDARE!!!",
      "portrait": "spr_face_papyrusmad",
      "font": "fnt_papyrus"
    }
  ],
  "planMurder": [
    {
      "text": "NOT A ROCK...?",
      "portrait": "spr_face_papyrusside",
      "font": "fnt_papyrus"
    },
    {
      "text": "OH NO!!!\nBY PROCESS OF\nELIMINATION!!!",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    },
    {
      "text": "THAT MEANS IT'S\nA HUMAN!!!",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    },
    {
      "text": "AHEM!!\nHUMAN!!",
      "portrait": "spr_face_papyrusside",
      "font": "fnt_papyrus"
    },
    {
      "text": "PREPARE YOURSELF!!\nFOR HIGH JINKS!\nFOR LOW JINKS!",
      "portrait": "spr_face_papyrusevil",
      "font": "fnt_papyrus"
    },
    {
      "text": "DANGERS!\nPUZZLES!\nCAPERS! JAPERS!",
      "portrait": "spr_face_papyrusevil",
      "font": "fnt_papyrus"
    },
    {
      "text": "BEING CAPTURED!!\nAND OTHER SORTS OF\nFUN ACTIVITIES.",
      "portrait": "spr_face_papyrusevil",
      "font": "fnt_papyrus"
    },
    {
      "text": "REFRESHMENTS WILL\nBE PROVIDED...",
      "portrait": "spr_face_papyrusevil",
      "font": "fnt_papyrus"
    },
    {
      "text": "IF YOU DARE!",
      "portrait": "spr_face_papyrusevil",
      "font": "fnt_papyrus"
    }
  ],
  "laugh": [
    {
      "text": "NYEH HEH HEH\nHEH HEH HEH\nHEH HEH!!!",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    }
  ],
  "bye": [
    {
      "text": "* well, that went well.",
      "portrait": "spr_face_sans",
      "font": "fnt_comicsans"
    },
    {
      "text": "* don't sweat it, kid.",
      "portrait": "spr_face_sans",
      "font": "fnt_comicsans"
    },
    {
      "text": "* i'll keep an eyesocket\n  out for ya.",
      "portrait": "spr_face_sanswink",
      "font": "fnt_comicsans"
    }
  ],
  "byeMurder": [
    {
      "text": "* ... and you don't even\n  bat an eye, huh?",
      "portrait": "spr_face_sans",
      "font": "fnt_comicsans"
    }
  ],
  "checkpoint": [
    {
      "text": "* There's some narration on this\n  cardboard box.",
      "portrait": null,
      "font": "fnt_maintext"
    },
    {
      "text": "YOU OBSERVE THE\nWELL-CRAFTED\nSENTRY STATION.",
      "portrait": null,
      "font": "fnt_papyrus"
    },
    {
      "text": "WHO COULD HAVE\nBUILT THIS, YOU\nPONDER...",
      "portrait": null,
      "font": "fnt_papyrus"
    },
    {
      "text": "I BET IT WAS\nTHAT VERY FAMOUS\nROYAL GUARDSMAN!",
      "portrait": null,
      "font": "fnt_papyrus"
    },
    {
      "text": "(NOTE: NOT YET A\nVERY FAMOUS\nROYAL GUARDSMAN.)",
      "portrait": null,
