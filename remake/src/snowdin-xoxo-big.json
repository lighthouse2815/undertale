    {
      "text": "* i mean.",
      "portrait": "spr_face_sans",
      "font": "fnt_comicsans"
    },
    {
      "text": "* it's impossible for\n  you to have seen\n  this one before.",
      "portrait": "spr_face_sans",
      "font": "fnt_comicsans"
    }
  ],
