  "papBefore": [
    {
      "text": "MY BROTHER STARTED\nA SOCK COLLECTION\nRECENTLY.",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    },
    {
      "text": "HOW SADDENING...",
      "portrait": "spr_face_papyrusside",
      "font": "fnt_papyrus"
    },
    {
      "text": "SOMETIMES I WONDER\nWHAT HE WOULD\nDO...",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    },
    {
      "text": "WITHOUT SUCH A\nCOOL GUY TAKING\nCARE OF HIM???",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    },
    {
      "text": "NYEH HEH HEH!",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    }
  ],
  "papHint": [
    {
      "text": "SO, YOU WANT\nA HINT, HUH?",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    },
    {
      "text": "WELL...\nI'VE BEEN LOOKING\nAT THE PUZZLE...",
      "portrait": "spr_face_papyrusside",
      "font": "fnt_papyrus"
    },
    {
      "text": "AND I THINK THE\nSOLUTION...",
      "portrait": "spr_face_papyrusside",
      "font": "fnt_papyrus"
    },
    {
      "text": "IS TO TURN ALL\nOF THE X'S INTO\nO'S!",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    },
    {
      "text": "YOU SHOULD TRY\nTHAT!",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    },
    {
      "text": "ASK AGAIN FOR\nMORE GREAT HINTS!",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    }
  ],
  "papHintAgain": [
    {
      "text": "MAYBE SOLVING\nTHE LAST PUZZLE \nAGAIN WILL HELP.",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    },
    {
      "text": "ASK AGAIN FOR\nMORE GREAT HINTS!!",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    }
  ],
  "answerIntro": [
    {
      "text": "EUREKA!!!",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    },
    {
      "text": "I'VE FIGURED OUT\nTHE PUZZLE!!!",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    },
    {
      "text": "YOU SEEM LIKE\nYOU'RE HAVING\nFUN, THOUGH...",
      "portrait": "spr_face_papyrusside",
      "font": "fnt_papyrus"
    },
    {
      "text": "DO YOU ABSOLUTELY,\nDAPSOLUTELY WANT\nTHE SOLUTION???",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    }
  ],
  "answerAgain": [
    {
      "text": "I'VE FIGURED OUT\nTHE PUZZLE!!!",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    },
    {
      "text": "DO YOU ABSOLUTELY,\nDAPSOLUTELY WANT\nTHE SOLUTION???",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    }
  ],
  "answerYes": [
    {
      "text": "THE!\nSOLUTION!\nIS!",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    },
    {
      "text": "(PLEASE IMAGINE\nA DRUMROLL IN\nYOUR HEAD)",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    },
    {
      "text": "... THAT TREE\nOVER THERE HAS\nA SWITCH ON IT!",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    },
    {
      "text": "CHECK IT\nOUTIE!!!",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    }
  ],
  "answerNo": [
    {
      "text": "WOW...\nYOU'RE TRULY A\nPUZZLE PASSIONEER!",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    },
    {
      "text": "I'M SO ENTHUSED\nBY YOUR\nENTHUSIASM!!!",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    },
    {
      "text": "YOU CAN DO IT,\nHUMAN!!!",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    }
  ],
  "sans": [
    {
      "text": "* good job on solving it\n  so quickly.",
      "portrait": "spr_face_sans",
