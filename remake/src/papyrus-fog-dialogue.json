    {
      "text": "NO!!!\nYOU'RE GREAT!!!\nI'LL BE YOUR FRIEND!",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    }
  ],
  "afterChoiceDate": [
    {
      "text": "WOWIE!!\nWE HAVEN'T EVEN HAD\nOUR FIRST DATE...",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
