      "font": "fnt_papyrus"
    },
    {
      "text": "I'LL BE AT HOME\nBEING A COOL\nFRIEND!!!",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    },
    {
      "text": "FEEL FREE TO\nCOME BY AND HAVE\nTHAT DATE!",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    },
    {
      "text": "NYEH HEH HEH HEH\nHEH HEH HEH!!!",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    }
