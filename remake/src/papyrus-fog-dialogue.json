    {
      "text": "IS IT BECAUSE...",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    },
    {
      "text": "YOU DON'T THINK\nYOU'RE GOOD ENOUGH\nTO BE MY FRIEND?",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
