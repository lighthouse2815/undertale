    {
      "text": "I GUESS...",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    },
    {
      "text": "I GUESS\nI CAN MAKE AN\nALLOWANCE FOR YOU!",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    }
  ],
  "afterChoiceNo": [
    {
      "text": "HUH?\nWHY WOULD YOU...",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
