    {
      "text": "I'M SO PROUD I\nCOULD CRY!!!",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    },
    {
      "text": "... WAIT, WASN'T I\nSUPPOSED TO\nCAPTURE YOU...?",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    },
    {
      "text": "WELL, FORGET IT!",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    },
    {
      "text": "I JUST WANT YOU\nTO BE THE BEST\nPERSON YOU CAN BE.",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    },
    {
      "text": "SO LET'S LET\nBYBONES BE\nBYBONES.",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    },
    {
      "text": "I'LL EVEN TELL YOU\nHOW TO LEAVE THE\nUNDERGROUND!",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    },
    {
      "text": "JUST KEEP GOING\nEAST!",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    },
    {
      "text": "EVENTUALLY YOU'LL\nREACH THE KING'S\nCASTLE.",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    },
    {
      "text": "THEN YOU CAN\nLEAVE!",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    }
