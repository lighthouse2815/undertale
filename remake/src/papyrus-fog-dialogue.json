  "afterIntroMurder": [
    {
      "text": "WOWIE!!\nYOU DID IT!!!",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    },
    {
      "text": "YOU DIDN'T DO A\nVIOLENCE!!!",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    },
    {
      "text": "TO BE HONEST,\nI WAS A LITTLE\nAFRAID...",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
    },
    {
      "text": "BUT YOU'RE ALREADY\nBECOMING A GREAT\nPERSON!",
      "portrait": "spr_face_papyrus",
      "font": "fnt_papyrus"
