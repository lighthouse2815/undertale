{
  "name": "undertale-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Undertale chạy độc lập trên web bằng dữ liệu, mã GML gốc và Butterscotch.",
  "scripts": {
    "dev": "npm --prefix game run dev",
    "start": "npm --prefix game start",
    "check": "npm --prefix game run check",
    "build:game": "node game/tools/build-game.mjs",
    "build": "node game/tools/build-web.mjs",
    "build:pages": "node game/tools/build-web.mjs --pages",
    "preview": "node dist/undertale-web/server.mjs",
    "test": "node tests/undertale.mjs",
    "test:build": "node tests/game-build.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1"
  }
}
