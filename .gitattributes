# Mã GML giải biên dịch có ký tự CR trong chuỗi; giữ nguyên byte khi checkout.
game/code/*.gml -text whitespace=cr-at-eol
# Giữ nguyên bảng credit gốc (encoding và CRLF).
game/CREDITS.txt -text whitespace=cr-at-eol
game/assets/misc/credits.txt -text whitespace=cr-at-eol
# Giữ nguyên giấy phép font được sao chép từ upstream.
game/assets/ui/fonts/OFL.txt -text -whitespace
# Mã nguồn thư viện được nhập nguyên bản, giữ định dạng upstream.
game/vendor/butterscotch/** -text -whitespace
